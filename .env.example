# OASIS WEB4 API base URL (Avatar SSO, Holon data, Karma)
OASIS_API_URL=https://api.web4.oasisomniverse.one

# OASIS WEB6 AI API base URL (Leela chat, FAHRN reasoning network, Holonic BRAID)
WEB6_API_URL=https://api.web6.oasisomniverse.one

# Leela AI assistant — FAHRN and Holonic BRAID are optional enhancements.
# When LEELA_USE_FAHRN=true, each chat message is first routed through the FAHRN
# reasoning-network dispatcher (POST /v1/reasoning-network/dispatch) before the
# final reply is generated. Adds latency but improves multi-step reasoning quality.
# When LEELA_USE_HOLONIC_BRAID=true, Leela fetches the shared trust-guidance
# reasoning graph (GET /v1/holonic-braid/graph/trust-guidance) and injects it as
# context before every completion — so reasoning patterns are shared globally.
LEELA_USE_FAHRN=false
LEELA_USE_HOLONIC_BRAID=false

# Stripe - required for checkout.html / api/checkout-session.js / api/checkout-status.js
# Use a test-mode secret key (sk_test_...) while developing.
STRIPE_SECRET_KEY=
